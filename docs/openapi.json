{
  "openapi": "3.1.0",
  "info": {
    "title": "Ship Public API",
    "version": "1.0.0",
    "description": "The Ship public API. Every endpoint is OAuth 2.0 bearer-authenticated and\nscope-gated; the required scope for an operation is published as the\n`x-required-scope` extension on that operation.\n\nFailures always use one envelope: `{ code, message, details?, request_id }`\n(see the `ApiError` schema). `request_id` correlates the response with the\naudit log and webhook delivery log.\n\nList endpoints are cursor-paginated: they return `{ data, next_cursor }`,\nwhere a null `next_cursor` means the last page.\n\nThis document is generated from route metadata at build time — it is never\nhand-written and cannot drift from the mounted router."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "OAuth 2.0 access token issued by Ship, sent as `Authorization: Bearer <token>`. Every operation additionally declares the scope it requires in `x-required-scope`."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "token_expired",
              "forbidden",
              "not_found",
              "validation_failed",
              "rate_limited",
              "server_error"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "additionalProperties": {}
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "workspace_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "client_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The OAuth app this token belongs to, or null for a personal access token."
          },
          "scopes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "workspace_id",
          "client_id",
          "scopes"
        ]
      },
      "Document": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "document_type": {
            "type": "string"
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "description": "Issue workflow state, when applicable."
          },
          "ticket_number": {
            "type": [
              "integer",
              "null"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "document_type",
          "state",
          "ticket_number",
          "parent_id",
          "created_at",
          "updated_at"
        ]
      },
      "CreateDocumentRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "document_type": {
            "type": "string",
            "enum": [
              "wiki",
              "issue",
              "sprint"
            ],
            "default": "wiki"
          },
          "parent_id": {
            "type": "string",
            "format": "uuid"
          },
          "content_text": {
            "type": "string",
            "maxLength": 100000,
            "description": "Plain-text body. Stored as a TipTap paragraph document."
          }
        },
        "required": [
          "title"
        ]
      },
      "Issue": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Document"
          },
          {
            "type": "object",
            "properties": {
              "assignee_id": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uuid"
              },
              "priority": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "assignee_id",
              "priority"
            ]
          }
        ]
      },
      "Sprint": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Document"
          },
          {
            "type": "object",
            "properties": {
              "start_date": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "end_date": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "start_date",
              "end_date"
            ]
          }
        ]
      }
    },
    "parameters": {}
  },

# Terraform-generated artifacts for the local-provider drift demo.
# The parent terraform/.gitignore already excludes .terraform/ and *.tfstate.

# Files that Terraform itself creates from main.tf — regenerated by apply.
managed/

# ...but DO commit the provider lock file. The exact version pin in main.tf is
# only half of reproducibility; the lock file records the provider checksums.
# This negates the `.terraform.lock.hcl` rule in terraform/.gitignore.
!.terraform.lock.hcl

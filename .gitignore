# Deployment artifacts
# scripts/deploy-api.sh emits deploy-api-${VERSION_LABEL}.zip, where VERSION_LABEL
# is itself "ship-api-<timestamp>". The bare `ship-api-*.zip` pattern below never
# matched that emitted prefix, so four ~590 KB bundles were committed at the repo
# root. Cover the actual emitted names.
deploy-api-*.zip
ship-api-*.zip
api-*.zip

# Terraform provider locks: only the root and environment locks are authoritative.
# Locks generated by running `init` inside a module directory carry no constraints
# block and resolved aws 6.28.0 against every root's `~> 5.0`.
terraform/modules/*/.terraform.lock.hcl

# Stray file whose leading hyphen makes most CLI tools parse it as a flag
/-progress.txt

# Vendor (local SDK links)
vendor/

# SSDF-Helper - Memory Safety Analysis Reports (CUI/ISVI)
/SSDF-Helper/
.pr-checklist.json
.dev-ports
.claude/settings.local.json

# Vite PWA dev artifacts
web/dev-dist/

# Coverage output (generated by vitest --coverage)
coverage/
**/coverage/

# bench transients: cookie jars (contain session tokens), pg log snapshots,
# counter scratch, sourcemap build output
bench/**/j_*.txt
bench/**/pglog.txt
bench/cat1-types/raw.json
web/dist-sourcemap-tmp/
